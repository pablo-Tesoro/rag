# Copy to .env (`make setup` does it) and adjust. Never commit .env.
# Everything here is for local development only.

# --- Postgres (docker compose) ---
POSTGRES_USER=olvessa
POSTGRES_PASSWORD=olvessa-dev-only
POSTGRES_DB=olvessa
# Host port for Postgres; change it if 5432 is already taken on your machine.
DB_PORT=5432
DATABASE_URL=postgresql://olvessa:olvessa-dev-only@localhost:5432/olvessa

# --- App ---
LOG_LEVEL=INFO
# Secret used to pseudonymise employee ids in logs (HMAC). Use a random value outside dev.
LOG_PSEUDONYM_KEY=dev-only-change-me
