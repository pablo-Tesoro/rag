# Copy to .env (`make setup` does it) and adjust. Never commit .env.
# Everything here is for local development only.

# --- Postgres (docker compose) ---
POSTGRES_USER=olvessa
POSTGRES_PASSWORD=olvessa-dev-only
POSTGRES_DB=olvessa
# Host port for Postgres; change it if 5432 is already taken on your machine.
DB_PORT=5432
DATABASE_URL=postgresql://olvessa:olvessa-dev-only@localhost:5432/olvessa

# --- App ---
LOG_LEVEL=INFO
# Host port for the API (docker compose).
APP_PORT=8000
# Secret used to pseudonymise employee ids in logs (HMAC). Use a random value outside dev.
LOG_PSEUDONYM_KEY=dev-only-change-me

# --- LLM (Gemini API, free tier) ---
# Any provider supported by LangChain's init_chat_model, as "provider:model".
LLM_MODEL=google_genai:gemini-3.5-flash-lite
# NEVER write the real key in this file: it is committed to a public repository.
# Put it in your local .env (git-ignored) or in the cloud environment's settings.
GOOGLE_API_KEY=

# --- Evaluation harness (make eval) ---
# Judge: a stronger model than the agent's. Same GOOGLE_API_KEY.
JUDGE_MODEL=google_genai:gemini-3.5-flash
# Client-side limit per model; lower it if the free tier answers 429.
EVAL_REQUESTS_PER_MINUTE=10
